# ── Required ──────────────────────────────────────────────────────────────────
# Your supermemory API key: this is where the brain reads and writes memory.
# Get one at https://console.supermemory.ai
SUPERMEMORY_API_KEY=""

# One model API key: Anthropic, OpenAI, Google or xAI. Paste whichever you have;
# the brain tells them apart by prefix. The prompts were tuned against Anthropic
# and xAI models.
MODEL_API_KEY=""

# Or set providers explicitly, e.g. to give it more than one:
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""
# XAI_API_KEY=""

# ── Optional ──────────────────────────────────────────────────────────────────
# Sandbox tools (shell, git, files). The containers block in wrangler.jsonc is
# enabled, so they run on a Cloudflare container and local dev needs Docker
# running. To use Daytona on any plan instead, comment that block out, set
# CONTAINER_SANDBOX to "off", and uncomment this:
# DAYTONA_API_KEY=""

# Web search and page reading use Firecrawl's free keyless tier by default
# (1,000 credits a month). Set a key for more, or a context.dev key to use that.
# FIRECRAWL_API_KEY=""
# CONTEXT_DEV_API_KEY=""

# TypeSafe AI / Jev System 1 Decision Model: ultra-fast, zero-token-waste
# decision engine for MCP action effect classification, skills routing, and triage.
# TYPESAFE_API_KEY=""

# PostHog analytics + LLM observability (optional). Unset = silent no-op.
# POSTHOG_API_KEY=""
# POSTHOG_HOST="https://us.posthog.com"
