{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "company-brain",
	"main": "src/worker.ts",
	"compatibility_date": "2025-06-22",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env",
		"enable_ctx_exports"
	],
	"minify": true,
	"build": {
		"command": "bun run build:web",
		"watch_dir": ["src", "web"]
	},
	"assets": {
		"directory": "./dist/web",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/brain/*",
			"/slack/*",
			"/auth/*",
			"/setup",
			"/setup/*",
			"/health"
		]
	},
	"vars": {
		// "on" once the Workers Paid block below is enabled: sandbox tools then
		// run on a Cloudflare container.
		"CONTAINER_SANDBOX": "off",
		// The sandbox SDK's RPC transport; artifact downloads stream over it.
		"SANDBOX_TRANSPORT": "rpc",
		// OpenAI-compatible endpoint for the free models. This only applies to the
		// chat-completions models in the registry; OpenAI's own models still go to
		// api.openai.com. Point it elsewhere (e.g. Workers AI) to switch providers.
		"OPENAI_BASE_URL": "https://openrouter.ai/api/v1"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "company",
			"database_id": "f30e54ef-e716-42d9-a01f-d5b6ed20f648",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "BRAIN_KV",
			"id": "356616be01244cad9b52c40bb6ff5a39"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "COMPANY_BRAIN_AGENT",
				"class_name": "CompanyBrainAgent"
			},
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CompanyBrainAgent"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Sandbox"
			]
		}
	],
	// ── Workers Paid ($5/mo) ─────────────────────────────────────────────────
	// The brain runs on the free plan. On Workers Paid, uncomment this block
	// and set CONTAINER_SANDBOX to "on" above to give it a built-in container
	// sandbox (shell, git, Python). Without it, sandbox tools use Daytona when
	// DAYTONA_API_KEY is set.
	//
	// "containers": [
	// 	{
	// 		"class_name": "Sandbox",
	// 		"image": "./sandbox/Dockerfile",
	// 		"instance_type": "basic",
	// 		"max_instances": 10
	// 	}
	// ],
	"unsafe": {
		"bindings": [
			{
				"type": "ratelimit",
				"name": "GMAIL_FETCH_RATE_LIMITER",
				"namespace_id": "1101",
				"simple": {
					"limit": 150,
					"period": 10
				}
			},
			{
				"type": "ratelimit",
				"name": "GRANOLA_FETCH_RATE_LIMITER",
				"namespace_id": "1102",
				"simple": {
					"limit": 25,
					"period": 10
				}
			}
		]
	}
}
