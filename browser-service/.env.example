# Same value as the worker's BROWSER_SERVICE_TOKEN secret.
BROWSER_SERVICE_TOKEN="change-me"
# One LLM key is required; BROWSER_LLM picks the provider
# (openai / anthropic / google / chat-browser-use), defaulting to the first
# key found in that order.
BROWSER_LLM=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_API_KEY=""
# BROWSER_USE_API_KEY=""
# Seconds per run; must stay below the worker's 5-minute client timeout.
BROWSER_MAX_SECONDS="240"
# BROWSER_HEADLESS=false shows the Chromium window for local debugging.
BROWSER_HEADLESS="true"
